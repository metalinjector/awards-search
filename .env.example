# Скопируйте в .env — docker compose подхватит значения автоматически.

# Пароль PostgreSQL (только буквы и цифры: он подставляется в DATABASE_URL).
# Действует при первом создании тома; для существующей базы оставьте прежний.
POSTGRES_PASSWORD=postgres

# Токен администратора — нужен, чтобы сохранять/удалять ключ TMDB через интерфейс.
# Сгенерировать: openssl rand -hex 24
ADMIN_TOKEN=

# Ключ TMDB (достаточно одного из двух) — включает раздел /tmdb
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Ключ r.jina.ai — повышает лимиты при чтении страниц Кинопоиска
JINA_API_KEY=
